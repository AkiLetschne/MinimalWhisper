def load_config() -> dict[str, str]:
    cfg = {
        "LITELLM_BASE_URL": "https://litellm.example.com/v1",
        "STT_MODEL": "gemini/gemini-2.5-flash",
        "CLEANUP_MODEL": "gemini/gemini-2.5-flash",
        "TERMS": "",
        "LITELLM_API_KEY": "",
    }
    if CONFIG.exists():
        for line in CONFIG.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, _, v = line.partition("=")
            cfg[k.strip()] = v.strip()
    if not cfg["LITELLM_API_KEY"]:
        sys.exit("dictate: LITELLM_API_KEY missing in ~/.config/dictate/config")
    return cfg


def notify(title: str, body: str = "") -> None:
    subprocess.Popen(
        ["notify-send", "-a", "Dictate", title, body],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def running_pid() -> int | None:
    if not PID_FILE.exists():
        return None
    try:
        pid = int(PID_FILE.read_text().strip())
    except ValueError:
        return None
    try:
        os.kill(pid, 0)
    except OSError:
        PID_FILE.unlink(missing_ok=True)
        return None
    return pid


def start_record() -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    WAV_FILE.unlink(missing_ok=True)
    proc = subprocess.Popen(
        ["arecord", "-q", "-f", "S16_LE", "-r", "16000", "-c", "1", "-t", "wav", str(WAV_FILE)],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    PID_FILE.write_text(str(proc.pid))


def stop_record() -> Path | None:
    pid = running_pid()
    if pid is None:
        return None
    os.kill(pid, signal.SIGINT)
    for _ in range(40):
        try:
            os.kill(pid, 0)
        except OSError:
            break
        time.sleep(0.05)
    PID_FILE.unlink(missing_ok=True)
    if not WAV_FILE.exists() or WAV_FILE.stat().st_size < 16000:
        return None
    return WAV_FILE


def multipart(wav: Path, model: str) -> tuple[bytes, str]:
    boundary = "dictateBoundary"
    data = wav.read_bytes()
    parts = [
        f"--{boundary}\r\nContent-Disposition: form-data; name=\"file\"; filename=\"audio.wav\"\r\nContent-Type: audio/wav\r\n\r\n".encode(),
        data,
        f"\r\n--{boundary}\r\nContent-Disposition: form-data; name=\"model\"\r\n\r\n{model}\r\n".encode(),
        f"--{boundary}--\r\n".encode(),
    ]
    return b"".join(parts), f"multipart/form-data; boundary={boundary}"


def http_json(url: str, key: str, body: bytes, content_type: str) -> dict:
    req = urllib.request.Request(
        url,
        data=body,
        method="POST",
        headers={"Authorization": f"Bearer {key}", "Content-Type": content_type},
    )
    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            return json.loads(resp.read().decode())
    except urllib.error.HTTPError as e:
        err = e.read().decode()[:400]
        raise RuntimeError(f"HTTP {e.code}: {err}") from e


def transcribe(cfg: dict[str, str], wav: Path) -> str:
    body, ctype = multipart(wav, cfg["STT_MODEL"])
    if b'name="prompt"' in body:
        raise RuntimeError("internal: prompt field must not be sent")
    data = http_json(
        f"{cfg['LITELLM_BASE_URL'].rstrip('/')}/audio/transcriptions",
        cfg["LITELLM_API_KEY"],
        body,
        ctype,
    )
    text = (data.get("text") or "").strip()
    if not text:
        raise RuntimeError("leeres Transkript")
    return text


def cleanup(cfg: dict[str, str], text: str) -> str:
    terms = cfg.get("TERMS", "").strip()
    system = "Clean up the transcript: punctuation, obvious stutters, keep the original language. Return only the cleaned text."
    if terms:
        system += f" Prefer these spellings: {terms}."
    payload = json.dumps(
        {
            "model": cfg["CLEANUP_MODEL"],
            "messages": [
                {"role": "system", "content": system},
                {"role": "user", "content": text},
            ],
        }
    ).encode()
    data = http_json(
        f"{cfg['LITELLM_BASE_URL'].rstrip('/')}/chat/completions",
        cfg["LITELLM_API_KEY"],
        payload,
        "application/json",
    )
    out = data["choices"][0]["message"]["content"].strip()
    return out or text


def paste(text: str) -> None:
    subprocess.run(["wl-copy", "--", text], check=True)
    time.sleep(0.08)
    env = os.environ.copy()
    env["YDOTOOL_SOCKET"] = YDOTOOL_SOCKET
    subprocess.run(["ydotool", "key", "29:1", "47:1", "47:0", "29:0"], check=True, env=env)


def daemon_alive() -> bool:
    if not SOCK_PATH.exists():
        return False
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(0.3)
        s.connect(str(SOCK_PATH))
        s.close()
        return True
    except OSError:
        return False


def send_cmd(cmd: str) -> None:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(2)
    s.connect(str(SOCK_PATH))
    s.sendall((cmd + "\n").encode())
    s.close()


def ensure_daemon() -> None:
    if daemon_alive():
        return
    env = os.environ.copy()
    env["GDK_BACKEND"] = "x11"
    subprocess.Popen(
        [sys.executable, str(Path(__file__).resolve()), "daemon"],
        env=env,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    for _ in range(40):
        if daemon_alive():
            return
        time.sleep(0.05)
    sys.exit("dictate: overlay startete nicht")


def run_daemon() -> None:
    os.environ["GDK_BACKEND"] = "x11"

    import gi

    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gtk, GLib, Gdk

    cfg = load_config()
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    if SOCK_PATH.exists():
        SOCK_PATH.unlink()

    state = {"mode": "idle", "t0": 0.0, "pulse": False}

    app = Gtk.Application(application_id="org.minimalwhispr.dictate", flags=0)

    def set_mode(mode: str, text: str | None = None) -> None:
        state["mode"] = mode
        for cls in ("recording", "pulse", "busy", "error", "ok"):
            orb.get_style_context().remove_class(cls)
        if mode == "recording":
            orb.get_style_context().add_class("recording")
            pill.set_text("Aufnahme")
            pill.show()
        elif mode == "busy":
            orb.get_style_context().add_class("busy")
            pill.set_text("Transkribiere…")
            pill.show()
        elif mode == "error":
            orb.get_style_context().add_class("error")
            pill.set_text(text or "Fehler")
            pill.show()
            GLib.timeout_add(2500, lambda: (set_mode("idle") or False))
        elif mode == "ok":
            orb.get_style_context().add_class("ok")
            pill.set_text(text or "OK")
            pill.show()
            GLib.timeout_add(1800, lambda: (set_mode("idle") or False))
        else:
            pill.hide()
        GLib.idle_add(place)

    def do_finish() -> None:
        wav = stop_record()
        if wav is None:
            GLib.idle_add(set_mode, "error", "Zu kurz")
            return
        GLib.idle_add(set_mode, "busy")
        try:
            raw = transcribe(cfg, wav)
            try:
                text = cleanup(cfg, raw)
            except Exception:
                text = raw
            paste(text)
            shown = text if len(text) < 42 else text[:39] + "…"
            GLib.idle_add(set_mode, "ok", shown)
        except Exception as e:
            GLib.idle_add(set_mode, "error", str(e)[:48])
            notify("Dictate fehlgeschlagen", str(e)[:300])

    def toggle(*_a) -> None:
        if state["mode"] == "busy":
            return
        if running_pid() is not None:
            threading.Thread(target=do_finish, daemon=True).start()
            return
        start_record()
        state["t0"] = time.time()
        set_mode("recording")

    def on_tick() -> bool:
        if state["mode"] == "recording":
            state["pulse"] = not state["pulse"]
            ctx = orb.get_style_context()
            if state["pulse"]:
                ctx.add_class("pulse")
            else:
                ctx.remove_class("pulse")
            elapsed = int(time.time() - state["t0"])
            pill.set_text(f"{elapsed // 60}:{elapsed % 60:02d}")
        return True

    def place(*_a) -> bool:
        gdk_win = win.get_window()
        if not gdk_win:
            return False
        display = Gdk.Display.get_default()
        _screen, px, py, _mask = display.get_pointer()
        monitor = display.get_monitor_at_point(px, py) or display.get_primary_monitor()
        geo = monitor.get_workarea()
        w, h = win.get_size()
        x = geo.x + geo.width - w - 18
        y = geo.y + geo.height - h - 18
        x = min(max(geo.x, x), geo.x + geo.width - w)
        y = min(max(geo.y, y), geo.y + geo.height - h)
        if win.get_position() != (x, y):
            win.move(x, y)
        return False

    def on_activate(_app: Gtk.Application) -> None:
        nonlocal orb, pill, win
        win = Gtk.ApplicationWindow(application=app)
        win.set_title("Dictate")
        win.set_decorated(False)
        win.set_resizable(False)
        win.set_keep_above(True)
        win.set_skip_taskbar_hint(True)
        win.set_skip_pager_hint(True)
        win.set_accept_focus(False)
        win.set_app_paintable(True)
        win.set_type_hint(Gdk.WindowTypeHint.UTILITY)
        visual = win.get_screen().get_rgba_visual()
        if visual:
            win.set_visual(visual)

        css = Gtk.CssProvider()
        css.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        box.get_style_context().add_class("shell")
        box.set_margin_top(6)
        box.set_margin_bottom(6)
        box.set_margin_start(6)
        box.set_margin_end(6)

        pill = Gtk.Label(label="")
        pill.get_style_context().add_class("pill")
        pill.set_no_show_all(True)

        orb = Gtk.Button()
        orb.get_style_context().add_class("orb")
        orb.set_tooltip_text("F8 · Diktat")
        icon = Gtk.Image.new_from_icon_name("audio-input-microphone-symbolic", Gtk.IconSize.BUTTON)
        icon.set_pixel_size(22)
        orb.add(icon)
        orb.connect("clicked", toggle)

        box.pack_start(pill, False, False, 0)
        box.pack_start(orb, False, False, 0)
        win.add(box)
        win.connect("map-event", lambda *_: (place() or False))
        win.connect("size-allocate", lambda *_: GLib.idle_add(place))
        win.show_all()
        pill.hide()
        place()

        GLib.timeout_add(450, on_tick)

        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        srv.bind(str(SOCK_PATH))
        srv.listen(4)
        srv.setblocking(False)

        def on_sock(*_a):
            try:
                conn, _ = srv.accept()
            except BlockingIOError:
                return True
            with conn:
                data = conn.recv(64).decode().strip()
            if data == "TOGGLE":
                toggle()
            elif data == "QUIT":
                app.quit()
            return True

        GLib.unix_fd_add_full(GLib.PRIORITY_DEFAULT, srv.fileno(), GLib.IOCondition.IN, on_sock, None)

    orb = pill = win = None  # type: ignore
    app.connect("activate", on_activate)
    try:
        app.run([])
    finally:
        pid = running_pid()
        if pid:
            try:
                os.kill(pid, signal.SIGTERM)
            except OSError:
                pass
        SOCK_PATH.unlink(missing_ok=True)


def main() -> None:
    cmd = sys.argv[1] if len(sys.argv) > 1 else "toggle"
    if cmd == "daemon":
        run_daemon()
        return
    ensure_daemon()
    send_cmd("TOGGLE" if cmd == "toggle" else cmd.upper())


if __name__ == "__main__":
    main()
